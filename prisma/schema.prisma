datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  mobileNumber String   @unique
  avatarUrl    String?
  role         String   @default("STORE_MANAGER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeAssignments  UserStoreAssignment[]
  regionAssignments UserRegionAssignment[]
  actionsTaken      Action[]
  requestedRecs     Recommendation[]       @relation("RequestedRecs")
}

model UserStoreAssignment {
  id      String @id @default(uuid())
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

model UserRegionAssignment {
  id       String @id @default(uuid())
  userId   String
  regionId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
}

model AuditLog {
  id            String   @id @default(uuid())
  correlationId String
  userId        String?
  action        String
  entityName    String
  entityId      String
  oldValues     String?  @db.Text
  newValues     String?  @db.Text
  ipAddress     String?
  timestamp     DateTime @default(now())

  @@index([entityName, entityId])
  @@index([correlationId])
}

model Category {
  id               String     @id @default(uuid())
  code             String     @unique
  name             String
  parentCategoryId String?
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[] @relation("SubCategories")
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  products         Product[]
}

model Brand {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  productCode   String   @unique
  name          String
  description   String?
  brandId       String
  categoryId    String
  unitOfMeasure String
  costPrice     Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  mrp           Decimal  @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand           Brand                  @relation(fields: [brandId], references: [id])
  category        Category               @relation(fields: [categoryId], references: [id])
  inventories     Inventory[]
  inventoryRules  InventoryRule[]
  salesLines      SalesTransactionLine[]
  transferLines   StockTransferLine[]
  recommendations Recommendation[]

  @@index([categoryId])
  @@index([brandId])
}

model Region {
  id       String                 @id @default(uuid())
  code     String                 @unique
  name     String
  isActive Boolean                @default(true)
  stores   Store[]
  users    UserRegionAssignment[]
}

model StoreType {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  stores Store[]
}

model Store {
  id          String   @id @default(uuid())
  storeCode   String   @unique
  name        String
  regionId    String
  storeTypeId String
  city        String
  address     String?
  latitude    Float?
  longitude   Float?
  openingDate DateTime @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region                Region                @relation(fields: [regionId], references: [id])
  storeType             StoreType             @relation(fields: [storeTypeId], references: [id])
  inventories           Inventory[]
  inventoryRules        InventoryRule[]
  salesTransactions     SalesTransaction[]
  transfersOutgoing     StockTransfer[]       @relation("SourceStore")
  transfersIncoming     StockTransfer[]       @relation("DestinationStore")
  recommendationsAsDest Recommendation[]      @relation("DestStoreRec")
  recommendationsAsSrc  Recommendation[]      @relation("SourceStoreRec")
  userAssignments       UserStoreAssignment[]

  @@index([regionId])
  @@index([city])
}

model Inventory {
  id                String   @id @default(uuid())
  storeId           String
  productId         String
  availableQuantity Decimal  @default(0.000) @db.Decimal(10, 3)
  reservedQuantity  Decimal  @default(0.000) @db.Decimal(10, 3)
  inTransitQuantity Decimal  @default(0.000) @db.Decimal(10, 3)
  minimumStock      Decimal  @default(10.000) @db.Decimal(10, 3)
  maximumStock      Decimal  @default(100.000) @db.Decimal(10, 3)
  reorderLevel      Decimal  @default(20.000) @db.Decimal(10, 3)
  version           Int      @default(1)
  lastUpdatedOn     DateTime @default(now()) @updatedAt

  store     Store               @relation(fields: [storeId], references: [id])
  product   Product             @relation(fields: [productId], references: [id])
  movements InventoryMovement[]

  @@unique([storeId, productId])
  @@index([productId])
  @@index([storeId])
}

model InventoryRule {
  id            String    @id @default(uuid())
  storeId       String
  productId     String
  minimumStock  Decimal   @db.Decimal(10, 3)
  maximumStock  Decimal   @db.Decimal(10, 3)
  reorderLevel  Decimal   @db.Decimal(10, 3)
  safetyStock   Decimal   @db.Decimal(10, 3)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  version       Int       @default(1)

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([storeId, productId, isActive])
}

model InventoryMovement {
  id            String   @id @default(uuid())
  inventoryId   String
  movementType  String
  quantity      Decimal  @db.Decimal(10, 3)
  referenceType String
  referenceId   String
  remarks       String?
  createdBy     String
  movementDate  DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id                 String    @id @default(uuid())
  transferNumber     String    @unique
  fromStoreId        String
  toStoreId          String
  status             String    @default("PENDING_APPROVAL")
  carrierName        String?
  vehicleNumber      String?
  dispatchNoteNumber String?
  estimatedArrival   DateTime?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  requestedBy        String
  approvedBy         String?
  receivedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fromStore      Store               @relation("SourceStore", fields: [fromStoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toStore        Store               @relation("DestinationStore", fields: [toStoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines          StockTransferLine[]
  recommendation Recommendation?

  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([status])
}

model StockTransferLine {
  id              String   @id @default(uuid())
  stockTransferId String
  productId       String
  requestedQty    Decimal  @db.Decimal(10, 3)
  approvedQty     Decimal? @db.Decimal(10, 3)
  receivedQty     Decimal? @db.Decimal(10, 3)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([stockTransferId, productId])
}

model Recommendation {
  id                   String   @id @default(uuid())
  recommendationNumber String   @unique
  recommendationType   String   @default("STOCK_TRANSFER")
  storeId              String
  productId            String
  fromStoreId          String?
  toStoreId            String?
  recommendedQuantity  Decimal  @db.Decimal(10, 3)
  priority             String   @default("HIGH")
  reason               String
  status               String   @default("OPEN")
  isManualRequest      Boolean  @default(false)
  requestedByUserId    String?
  aiExplanation        String?
  stockTransferId      String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store           Store                    @relation("DestStoreRec", fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromStore       Store?                   @relation("SourceStoreRec", fields: [fromStoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product         Product                  @relation(fields: [productId], references: [id])
  requestedByUser User?                    @relation("RequestedRecs", fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockTransfer   StockTransfer?           @relation(fields: [stockTransferId], references: [id])
  evidence        RecommendationEvidence[]
  actions         Action[]

  @@index([storeId, status])
  @@index([priority])
  @@index([isManualRequest])
}

model RecommendationEvidence {
  id               String @id @default(uuid())
  recommendationId String
  metric           String
  value            String
  description      String

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}

model SalesTransaction {
  id                String   @id @default(uuid())
  transactionNumber String   @unique
  storeId           String
  transactionDate   DateTime @default(now())
  customerId        String?
  totalQuantity     Decimal  @db.Decimal(10, 3)
  totalAmount       Decimal  @db.Decimal(12, 2)

  store Store                  @relation(fields: [storeId], references: [id])
  lines SalesTransactionLine[]

  @@index([storeId, transactionDate])
}

model SalesTransactionLine {
  id                 String  @id @default(uuid())
  salesTransactionId String
  productId          String
  quantity           Decimal @db.Decimal(10, 3)
  unitPrice          Decimal @db.Decimal(12, 2)
  discount           Decimal @default(0.00) @db.Decimal(12, 2)
  netAmount          Decimal @db.Decimal(12, 2)

  salesTransaction SalesTransaction @relation(fields: [salesTransactionId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Action {
  id               String   @id @default(uuid())
  recommendationId String
  actionType       String
  actionedBy       String
  actionedOn       DateTime @default(now())
  comments         String?

  recommendation Recommendation  @relation(fields: [recommendationId], references: [id])
  user           User            @relation(fields: [actionedBy], references: [id])
  history        ActionHistory[]

  @@index([recommendationId])
}

model ActionHistory {
  id             String   @id @default(uuid())
  actionId       String
  previousStatus String
  newStatus      String
  changedBy      String
  changedOn      DateTime @default(now())
  comments       String?

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}
